{
  "name": "mks2508/utils",
  "version": "0.0.1",
  "description": "Shared utilities for telegram-bot-manager",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "bun": "./src/logger.ts",
      "import": "./src/logger.ts"
    },
    "./result": {
      "types": "./src/result.ts",
      "bun": "./src/result.ts",
      "import": "./src/result.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rolldown --config rolldown.config.ts && tsgo --emitDeclarationOnly",
    "typecheck": "tsgo --noEmit",
    "dev": "bun --watch src/index.ts"
  },
  "dependencies": {
    "@mks2508/better-logger": "^4.0.0",
    "@mks2508/no-throw": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rolldown": "^1.0.0-beta.58"
  },
  "publishConfig": {
    "access": "public"
  }
}
