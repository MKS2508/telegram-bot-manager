{
  "name": "@mks2508/telegram-bot-manager",
  "version": "0.1.1",
  "description": "Telegram Bot Manager - CLI & Library for BotFather automation via GramJS MTProto",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "telegram-bot-manager": "./dist/bin/cli.js",
    "tbm": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run build:lib && bun run build:cli",
    "build:lib": "tsgo -p tsconfig.build.json",
    "build:cli": "bun build ./src/cli/index.ts --outfile ./dist/bin/cli.js --target node --minify",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "telegram",
    "bot",
    "botfather",
    "cli",
    "manager",
    "gramjs",
    "mtproto",
    "automation"
  ],
  "author": "MKS2508",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MKS2508/telegram-bot-manager"
  },
  "homepage": "https://github.com/MKS2508/telegram-bot-manager#readme",
  "bugs": {
    "url": "https://github.com/MKS2508/telegram-bot-manager/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.3",
    "@mks2508/better-logger": "^4.0.0",
    "big-integer": "^1.6.52",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "ora": "^8.0.0",
    "telegraf": "^4.16.3",
    "telegram": "^2.26.16",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/big-integer": "^0.0.31",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
