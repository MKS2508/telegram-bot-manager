{
  "name": "mks2508/main",
  "version": "0.1.0",
  "description": "Telegram Bot management library - automates bot creation via BotFather, groups/forums setup, and topics management using GramJS MTProto",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "rolldown --config rolldown.config.ts && tsgo --emitDeclarationOnly",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint",
    "test": "bun test"
  },
  "dependencies": {
    "mks2508/utils": "workspace:*",
    "telegram": "^2.26.16",
    "telegraf": "^4.16.3",
    "big-integer": "^1.6.52",
    "zod": "^3.24.0",
    "@inquirer/prompts": "^7.5.3",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/big-integer": "^0.0.31",
    "rolldown": "^1.0.0-beta.58"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
